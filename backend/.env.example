# Copy this file to .env and fill in your real values

PORT=5000

# Turso (LibSQL/SQLite cloud) database
TURSO_URL=libsql://YOUR_DATABASE_NAME.turso.io
TURSO_TOKEN=your_turso_auth_token_here

# JWT secret — use a long random string in production
JWT_SECRET=your_jwt_secret_key_here

# Razorpay payment gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ─── WhatsApp Business Cloud API (Meta) ───────────────────────────────────────
# Get these from: https://developers.facebook.com → Your App → WhatsApp → API Setup
#
# Step 1: Create Meta App at https://developers.facebook.com/apps
# Step 2: Add "WhatsApp" product to your app
# Step 3: In API Setup → get your Phone Number ID
# Step 4: Generate a Permanent Access Token (System User token recommended)
# Step 5: In Webhooks section: set URL = https://YOUR-BACKEND.vercel.app/api/webhooks/whatsapp
#          Set Verify Token = same value as WA_WEBHOOK_VERIFY_TOKEN below
# Step 6: Subscribe to "messages" webhook field
#
WA_PHONE_NUMBER_ID=your_phone_number_id_here
WA_ACCESS_TOKEN=your_permanent_access_token_here
WA_WEBHOOK_VERIFY_TOKEN=lekya_specs_webhook_2024
